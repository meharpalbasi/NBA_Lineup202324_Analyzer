<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nbalineup.lineups</string>

    <!-- OPTIONAL mid-week refresh of the legacy 5-man lineup CSV (see scripts/run_lineups.sh).
         The Monday supplementary job already refreshes it; load this only if you want the
         every-2-days cadence the retired Railway cron had. -->

    <!-- Mac mini paths (user: meharpal, clone dir: ~/apps/NBA_Lineup202324_Analyzer — NOT ~/Documents, which macOS TCC blocks for launchd). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/meharpal/apps/NBA_Lineup202324_Analyzer/scripts/run_lineups.sh</string>
    </array>

    <!-- launchd starts jobs with a bare PATH; give it git + homebrew. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Wednesdays + Fridays at 08:00 local (Monday is covered by the supplementary job).
         Runs on next wake if the mini was asleep. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/meharpal/apps/NBA_Lineup202324_Analyzer/scripts/logs/launchd.lineups.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/meharpal/apps/NBA_Lineup202324_Analyzer/scripts/logs/launchd.lineups.err.log</string>
</dict>
</plist>
